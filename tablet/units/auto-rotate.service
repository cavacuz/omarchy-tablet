[Unit]
Description=Auto-rotate internal display + touch (iio-sensor-proxy)
After=default.target
# A missing dependency must not spin forever: give up after 5 fast
# failures (see journal) instead of thousands of silent restarts.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.config/hypr/scripts/auto-rotate.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
